generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String  @id @default(cuid())
  telegramId     BigInt  @unique
  telegramHandle String?

  // Notification prefs (deribit-specific)
  notifyOrderFilled    Boolean @default(true)
  notifyOrderCancelled Boolean @default(true)
  notifyErrors         Boolean @default(true)

  apiKeys        ApiKey[]
  magicLinks     MagicLink[]
  deribitAccount DeribitAccount?
}

model DeribitAccount {
  id           String   @id @default(cuid())
  userId       String   @unique
  clientId     String
  clientSecret String
  baseUrl      String   @default("wss://www.deribit.com/ws/api/v2")
  isTestnet    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ApiKeyScope {
  ACCOUNT_READ
  MARKET_READ
  WALLET_READ
  WALLET_WRITE
  TRADING_READ
  TRADING_WRITE
  ADMIN
}

model ApiKey {
  id         String        @id @default(cuid())
  userId     String
  keyId      String        @unique
  secretHash String
  scopes     ApiKeyScope[] @default([ACCOUNT_READ, MARKET_READ, TRADING_READ])
  expiresAt  DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MagicLink {
  id        String        @id @default(cuid())
  userId    String
  token     String        @unique
  scopes    ApiKeyScope[] @default([ACCOUNT_READ, MARKET_READ, TRADING_READ])
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
