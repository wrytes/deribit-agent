generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String  @id @default(cuid())
  telegramId     BigInt  @unique
  telegramHandle String?

  // Notification prefs (deribit-specific)
  notifyOrderFilled    Boolean @default(true)
  notifyOrderCancelled Boolean @default(true)
  notifyErrors         Boolean @default(true)

  apiKeys        ApiKey[]
  magicLinks     MagicLink[]
  deribitAccount DeribitAccount?
  strategies     Strategy[]
}

model DeribitAccount {
  id           String   @id @default(cuid())
  userId       String   @unique
  clientId     String
  clientSecret String
  baseUrl      String   @default("wss://www.deribit.com/ws/api/v2")
  isTestnet    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ApiKeyScope {
  ACCOUNT_READ
  MARKET_READ
  WALLET_READ
  WALLET_WRITE
  TRADING_READ
  TRADING_WRITE
  ADMIN
}

model ApiKey {
  id         String        @id @default(cuid())
  userId     String
  keyId      String        @unique
  secretHash String
  scopes     ApiKeyScope[] @default([ACCOUNT_READ, MARKET_READ, TRADING_READ])
  expiresAt  DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MagicLink {
  id        String        @id @default(cuid())
  userId    String
  token     String        @unique
  scopes    ApiKeyScope[] @default([ACCOUNT_READ, MARKET_READ, TRADING_READ])
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Market Data
// ---------------------------------------------------------------------------

/// Hourly snapshot of market-wide metrics per currency (BTC, ETH).
/// Used for IV rank computation, realized vol, and USD conversion.
model MarketSnapshot {
  id           String   @id @default(cuid())
  currency     String // BTC | ETH
  timestamp    DateTime @default(now())
  indexPrice   Decimal // BTC/ETH index price in USD
  dvolIndex    Decimal? // Deribit Volatility Index value (DVOL)
  rv30d        Decimal? // 30-day realized volatility (annualised, 0–1)
  ivRank       Decimal? // IV Rank 0–100  ((cur - min52w) / (max52w - min52w) * 100)
  ivPercentile Decimal? // % of days in last year where DVOL was below current

  @@index([currency, timestamp])
}

// ---------------------------------------------------------------------------
// Strategies
// ---------------------------------------------------------------------------

enum StrategyType {
  WHEEL
  COVERED_CALL
  CASH_SECURED_PUT
  IRON_CONDOR
  STRANGLE
  STRADDLE
  DELTA_NEUTRAL
  CUSTOM
}

enum StrategyStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

/// A named, capital-allocated trading strategy with a lifecycle and configurable params.
model Strategy {
  id          String         @id @default(cuid())
  userId      String
  name        String
  type        StrategyType
  status      StrategyStatus @default(DRAFT)
  description String?

  /// BTC amount ring-fenced for this strategy
  allocationBtc Decimal @default(0)

  /// Strategy-specific configuration stored as JSON.
  /// Keys vary by type: ivrThreshold, dteRange, strikeDelta, maxLossUsd, autoRoll, targetDelta, …
  params Json @default("{}")

  realizedPnlBtc Decimal @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  legs      StrategyLeg[]
  snapshots StrategySnapshot[]

  @@index([userId, status])
}

/// A single option or perpetual leg associated with a strategy.
model StrategyLeg {
  id             String    @id @default(cuid())
  strategyId     String
  instrumentName String // e.g. BTC-28MAR25-70000-C
  direction      String // buy | sell
  quantity       Decimal
  openPrice      Decimal
  openTimestamp  DateTime  @default(now())
  closePrice     Decimal?
  closeTimestamp DateTime?
  orderId        String? // Deribit order_id for cross-reference
  isOpen         Boolean   @default(true)

  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([strategyId, isOpen])
}

/// Hourly snapshot of a strategy's greeks and unrealized PnL.
model StrategySnapshot {
  id         String   @id @default(cuid())
  strategyId String
  timestamp  DateTime @default(now())

  // Aggregated greeks across all open legs
  delta Decimal?
  gamma Decimal?
  theta Decimal?
  vega  Decimal?

  unrealizedPnlBtc Decimal?
  btcIndexPrice    Decimal // BTC price at snapshot time (for USD conversion)

  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([strategyId, timestamp])
}
