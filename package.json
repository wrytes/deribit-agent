{
	"name": "@wrytes/deribit-agent",
	"version": "0.1.0",
	"description": "Deribit ML Trading Agent — data pipeline, training, live execution",
	"author": "Wrytes",
	"private": true,
	"license": "MIT",
	"scripts": {
		"build": "nest build",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "nest start",
		"dev": "nest start --watch",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"infra:up": "docker stack deploy -c stack.testing.yml deribit-agent",
		"infra:down": "docker stack remove deribit-agent",
		"db:generate": "prisma generate",
		"db:push": "prisma db push",
		"db:migrate": "prisma migrate dev",
		"db:migrate:deploy": "prisma migrate deploy",
		"db:studio": "prisma studio",
		"db:reset": "prisma migrate reset"
	},
	"dependencies": {
		"@nestjs/bullmq": "^11.0.4",
		"@nestjs/common": "^11.0.1",
		"@nestjs/config": "^4.0.2",
		"@nestjs/core": "^11.0.1",
		"@nestjs/event-emitter": "^3.0.1",
		"@nestjs/platform-express": "^11.0.1",
		"@nestjs/schedule": "^6.1.1",
		"@nestjs/swagger": "^11.2.5",
		"@nestjs/terminus": "^11.0.0",
		"@nestjs/throttler": "^6.5.0",
		"@prisma/client": "6.19.2",
		"@telegraf/session": "^2.0.0-beta.7",
		"@wrytlabs/deribit-api-client": "link:../../wrytlabs/deribit-api-client",
		"bcrypt": "^6.0.0",
		"bullmq": "^5.76.6",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.3",
		"ioredis": "^5.9.3",
		"joi": "^18.0.2",
		"nanoid": "^5.1.6",
		"nestjs-pino": "^4.5.0",
		"nestjs-telegraf": "^2.9.1",
		"pino-http": "^11.0.0",
		"pino-pretty": "^13.1.3",
		"prisma": "6.19.2",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"telegraf": "^4.16.3"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.0",
		"@types/bcrypt": "^6.0.0",
		"@types/express": "^5.0.0",
		"@types/node": "^22.10.7",
		"prettier": "^3.4.2",
		"ts-node": "^10.9.2",
		"typescript": "^5.7.3"
	}
}
