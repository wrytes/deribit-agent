# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=3030
API_KEY_SECRET=your-super-secret-key-at-least-32-chars-long

# Deribit
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=
DERIBIT_BASE_URL=wss://test.deribit.com/ws/api/v2

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/deribit_agent

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_DOMAIN=
TELEGRAM_WEBHOOK_PATH=/telegram/webhook

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
