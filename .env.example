# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=3030
WRYTES_API_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/deribit_agent

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_DOMAIN=
TELEGRAM_WEBHOOK_PATH=/telegram/webhook

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# ML Trainer sidecar
# Use host.docker.internal when trainer runs in Docker on the same Mac
TRAINER_URL=http://localhost:8000

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
